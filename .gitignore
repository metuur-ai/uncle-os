# macOS
.DS_Store

# Python (the company-os CLI is a single-file Python script)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local-only working areas (company-os scratchpad convention)
scratchpad/
.company-os.local.yaml

# Environment / secrets
.env
.env.local

.devlocal/
# Go build output (the CLI source lives in company-os-starter/cmd/company-os)
/company-os-starter/company-os
/company-os-starter/cmd/company-os/company-os
/company-os-starter/dist/
/company-os-starter/coverage.out
